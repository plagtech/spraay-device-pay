# Private key of a dev wallet. Use a throwaway testnet wallet and never commit a real key.
DEVICE_PAY_PRIVATE_KEY=

# x402-protected URL used by the examples.
X402_URL=

# Base Sepolia integration test (pnpm test:integration). It is skipped unless both are set.
DEVICE_PAY_TESTNET_PRIVATE_KEY=
DEVICE_PAY_TESTNET_URL=
